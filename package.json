    "@supabase/supabase-js": "2.118.0",
    "cloudinary": "2.11.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
