# URL publik situs, tanpa garis miring di akhir.
# Lokal: http://localhost:3000 | Produksi: domain asli Anda.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Supabase) ---
# Dipakai aplikasi saat berjalan: role devnest_app lewat Transaction pooler (port 6543).
DATABASE_URL=postgresql://devnest_app.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Hanya untuk migrasi, seed, dan db:check: role postgres lewat Session pooler (port 5432).
# JANGAN dipasang di Vercel.
DATABASE_URL_MIGRATE=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase Auth (hanya dipakai server) ---
# Project URL: Supabase, Project Settings, API.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Kunci "publishable" (sb_publishable_...). JANGAN isi dengan kunci secret atau service_role.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx